# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# --- AI agents (Evaluator / Attacker / Defender) ---------------------------
ANTHROPIC_API_KEY=

# --- Environment graph (Neo4j) ----------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Threat intel sources ---------------------------------------------------
VULNCHECK_API_KEY=

# --- Host agent -> platform ingest -----------------------------------------
INGEST_ENDPOINT=https://localhost:8443/ingest
AGENT_ENROLL_ENDPOINT=https://localhost:8443/enroll
AGENT_ENROLL_TOKEN=
# The platform CA is non-secret; place it at ~/.host-agent/certs/ca.crt so the
# agent can trust the endpoints above. The agent's own key/cert are generated on
# first run and stored there too (never committed — *.crt/*.key are gitignored).
