# Copy to .env and adjust. Used by docker-compose; the SHADOWTWIN_* variables
# also work for the bare-metal service (see systemd unit's EnvironmentFile).

# GID of the 'wazuh' group on the Wazuh host, so the container can read
# /var/ossec/logs. Find it with:  getent group wazuh | cut -d: -f3
WAZUH_GID=999

# Optional overrides — take precedence over config.yaml.
SHADOWTWIN_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SHADOWTWIN_LOG_LEVEL=INFO
#SHADOWTWIN_STATE_FILE=/var/lib/shadowtwin-forwarder/state.json
#SHADOWTWIN_CONFIG=/etc/shadowtwin-forwarder/config.yaml
